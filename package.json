{
  "name": "yassir",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Yet Another Scryfall Search Interface Refinement: a form-driven query builder for scryfall.com",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "knip": "knip",
    "check": "npm run typecheck && npm run lint && npm run knip && npm test",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@preact/preset-vite": "^2.10.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "happy-dom": "^20.14.5",
    "knip": "6.38.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
