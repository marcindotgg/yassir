{
  "name": "scryfall-query-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Advanced search builder for scryfall.com: a form-driven query builder, a query explainer and set-name autocomplete",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build && npm run build:firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4",
    "playwright": "^1.63.0"
  }
}
